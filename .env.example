# Pilih metode autentikasi: qr atau pairing
AUTH_METHOD=qr

# Wajib diisi untuk AUTH_METHOD=pairing; format internasional tanpa + atau spasi
PHONE_NUMBER=6281234567890

# Prefix perintah, pisahkan dengan koma (contoh: .,! )
COMMAND_PREFIXES=.,!

# Local whisper.cpp transcription (default model: base)
# Defaults to .tools/whisper.cpp/build/bin/whisper-cli and models/ggml-base.bin
# WHISPER_CPP_PATH=/path/to/whisper-cli
# WHISPER_MODEL_PATH=/path/to/ggml-base.bin
WHISPER_THREADS=4

# AI assistant via local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
